# Gerar .env.test com: bash scripts/setup_test_env.sh
# O setup grava o caminho absoluto do banco e cria marcador/segredo aleatório.
APP_ENV=test
AUTH_MOCK=true
DATABASE_URL=sqlite:///.test-runtime/manual/jaci.sqlite3
DEBUG=false
SECURE_COOKIE=false
SMTP_MOCK=true
SMTP_USER=test@example.com
SMTP_PASSWORD=synthetic-only
BACKUP_ENABLED=false
APP_URL=http://127.0.0.1:8014
