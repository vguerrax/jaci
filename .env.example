# Application
APP_NAME=Jaci
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# Database (desenvolvimento)
DATABASE_URL=sqlite:///./data-dev/jaci.db
DATABASE_SSL_MODE=

# Backup PostgreSQL (SQLite é ignorado)
BACKUP_ENABLED=true
BACKUP_DIR=/var/backups/jaci
BACKUP_RETENTION_DAYS=30

# Auth
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MAGIC_LINK_EXPIRE_MINUTES=15
MAGIC_LINK_RESEND_SECONDS=60
SECURE_COOKIE=false
TUPA_URL=http://localhost:8001
TUPA_PRODUCT_ID=00000000-0000-0000-0000-000000000000
TUPA_SERVICE_TOKEN=
TUPA_TIMEOUT_SECONDS=10

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@jaci.app
SMTP_TLS=true

# Application URL (for magic links)
APP_URL=http://localhost:8000
