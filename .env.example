# Application
APP_NAME=Jaci
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# Database
DATABASE_URL=sqlite:///./jaci.db

# Auth
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MAGIC_LINK_EXPIRE_MINUTES=15
MAGIC_LINK_RESEND_SECONDS=60

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@jaci.app
SMTP_TLS=true

# Application URL (for magic links)
APP_URL=http://localhost:8000